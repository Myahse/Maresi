# PostgreSQL — Neon (production) or local
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/Maresi

# Set false when using a real database
DEV_AUTH_BYPASS=false

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Uploads — Cloudflare R2 (listing photos, selfie, ID card)
# Dashboard → R2 → bucket → Settings → Public access (r2.dev or custom domain)
# R2 API token: Object Read & Write
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=maresi-images
# Public base URL, no trailing slash. Must be an r2.dev subdomain or custom domain —
# NOT https://<accountid>.r2.cloudflarestorage.com (that host is private and images will not show).
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
# Optional override; default is https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=
UPLOAD_DIR=uploads

# SMS OTP (mock logs code to console in development)
SMS_PROVIDER=mock
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Genius Pay
GENIUSPAY_API_KEY=pk_sandbox_xxxxxxxx
GENIUSPAY_API_SECRET=sk_sandbox_xxxxxxxx
GENIUSPAY_WEBHOOK_SECRET=whsec_xxxxxxxx
# GENIUSPAY_BASE_URL=https://pay.genius.ci/api/v1/merchant
OWNER_SUBSCRIPTION_FCFA=10000
RESERVATION_COMMISSION_PERCENT=10
PAYMENT_SUCCESS_URL=http://localhost:3000/payments/success
PAYMENT_ERROR_URL=http://localhost:3000/payments/error
PAYMENT_HOST_SUCCESS_URL=http://localhost:3001/payments/success
PAYMENT_HOST_ERROR_URL=http://localhost:3001/payments/error
